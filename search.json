---
layout: none
---
[
  {% assign first = true %}
  {% for post in site.posts %}
    {% unless first %},{% endunless %}
    {
      "title"    : "{{ post.title | escape }}",
      "category" : "{{ post.category }}",
      "tags"     : "{{ post.tags | join: ', ' }}",
      "url"      : "{{ site.baseurl }}{{ post.url }}",
      "date"     : "{{ post.date }}",
      "type"     : "writing",
      "lang"     : "{{ post.lang | default: 'en' }}",
      "content"  : {{ post.content | strip_html | strip_newlines | jsonify }}
    }
    {% assign first = false %}
  {% endfor %}
  {% for note in site.notes %}
    ,
    {
      "title"    : "{{ note.label | default: note.title | escape }}",
      "category" : "",
      "tags"     : "{{ note.tags | join: ', ' }}",
      "url"      : "{{ site.baseurl }}{{ note.url }}",
      "date"     : "{{ note.date }}",
      "type"     : "note",
      "lang"     : "en",
      "content"  : {{ note.content | strip_html | strip_newlines | jsonify }}
    }
  {% endfor %}
  {% if site.research %}
  {% for item in site.research %}
    ,
    {
      "title"    : "{{ item.title | escape }}",
      "category" : "{{ item.venue_short | default: item.venue | escape }}",
      "tags"     : "{{ item.tags | join: ', ' }}",
      "url"      : "{% if item.links %}{{ item.links.paper | default: item.links.doi | default: item.url }}{% else %}{{ item.url }}{% endif %}",
      "date"     : "{{ item.date }}",
      "type"     : "research",
      "lang"     : "en",
      "content"  : {{ item.abstract | default: item.content | strip_html | strip_newlines | jsonify }}
    }
  {% endfor %}
  {% endif %}
  {% if site.teaching %}
  {% for item in site.teaching %}
    ,
    {
      "title"    : "{{ item.title | escape }}",
      "category" : "{{ item.institution | escape }}",
      "tags"     : "",
      "url"      : "{% if item.links.course %}{{ item.links.course }}{% else %}{{ item.url }}{% endif %}",
      "date"     : "{{ item.date }}",
      "type"     : "teaching",
      "lang"     : "en",
      "content"  : {{ item.description | default: item.content | strip_html | strip_newlines | jsonify }}
    }
  {% endfor %}
  {% endif %}
]
